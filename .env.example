# Email automation configuration
# Set true to skip fetching email inbox entirely (uses a dummy link instead)
SKIP_EMAIL=false

# Set true to skip creating Gmail drafts while still generating local draft files
SKIP_MAIL_DRAFT=true

# Optional: specify Gmail drafts mailbox path when default lookup fails
# Gmail日本語環境の例: "[Gmail]/下書き"、英語環境の例: "[Gmail]/Drafts"
GMAIL_DRAFTS_MAILBOX="[Gmail]/下書き"

# PostgreSQL connection URL (shared with recruit-nomi-hub style)
DB_URL=postgres://user:pass@localhost:5432/your_database
# Set DB_SSL=true to force SSL (e.g., RDS). Set DB_SSL_DISABLE=true to force disable.
# DB_SSL=false
# DB_SSL_DISABLE=true

# Tenant to read baitoru_credentials (defaults to 1 when unset)
BAITORU_TENANT_ID=1

# Chatwork and email credentials are read from DB tables (chatwork_settings/mail_settings)

# NTT CPaaS (Infobip) SMS settings
# Docs: https://ib.nttcpaas.com/docs/api/channels/sms/outbound-sms/send-sms-messages
# ホスト名のみを指定（例: your-subdomain.api.infobip.com）
NTT_CPAAS_BASE_HOST=your-subdomain.api.infobip.com
# APIキー（Console で発行）
NTT_CPAAS_API_KEY=your_ntt_cpaas_api_key
# 認証方式（既定: App）。必要に応じて basic / bearer / x-api-key も可
NTT_CPAAS_AUTH_SCHEME=App
# 送信元（アルファベットSender ID または +81形式の番号）。未指定時は "InfoSMS" を使用
NTT_CPAAS_DEFAULT_SENDER=InfoSMS
# 任意：タイムアウト(ms)
NTT_CPAAS_TIMEOUT_MS=15000

# Optional: choose Playwright browser profile when running scripts
# SELECTED_BROWSER=Mobile Safari
RECRUIT_PROSPECTS_API_BASE_URL=https://recruit.nomihub.jp
RECRUIT_PROSPECTS_API_TOKEN=
RECRUIT_PROSPECTS_API_TIMEOUT_MS=15000
